#!/bin/bash
# Backup dotfiles & configs to GitHub (private repo Ri256/bakup)
set -euo pipefail
export HOME="${HOME:-/home/rinas}"
G=(git --git-dir="$HOME/.cfg-store.git" --work-tree="$HOME")

# explicit list of tracked paths (keeps secrets out automatically via .gitignore)
"${G[@]}" add \
  .gitignore .zshrc .gitconfig .gtkrc-2.0 \
  .ssh/github.pub .ssh/gitlab.pub \
  apps-pacman.txt apps-pacman-all.txt apps-flatpak.txt RESTORE.md setup.sh LICENSE README.md \
  system/zapret-config.conf \
  .local/share/wallpapers \
  bin/bakup \
  .config/btop .config/htop .config/cava .config/hypr .config/i3 \
  .config/kate .config/katerc .config/dolphinrc .config/arkrc .config/baloofilerc

if "${G[@]}" diff --cached --quiet; then
  echo "Nothing to back up."
  exit 0
fi

"${G[@]}" commit -m "auto-backup $(date '+%F %T')"
"${G[@]}" push -u origin main
echo "Backup pushed."