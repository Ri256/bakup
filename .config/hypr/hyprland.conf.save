



# -------------------------------------------------
# 1. Общие параметры
# -------------------------------------------------
monitor=DP-1,1920x1080@60,0x0,1      # имя монитора, разрешение, позиция, масштаб
cursor_theme = Bibata-Modern-Ice  # тема курсора
cursor_size = 24

# -------------------------------------------------
# 2. Приложения, которые открывать в плавающем режиме
# -------------------------------------------------
windowrule = float, ^(pavucontrol)$
windowrule = float, ^(nm-connection-editor)$

# -------------------------------------------------
# 3. Привязка горячих клавиш (bind)
# -------------------------------------------------
# Формат: bind = <мод>, <клавиша>, <команда>
# <мод> может быть SUPER, ALT, CONTROL, SHIFT (можно комбинировать через +)
# <команда> – действие (exec, killactive, togglefloating, ...)

# Запуск часто‑используемых программ
bind = SUPER, Return, exec, alacritty                 # терминал
bind = SUPER, D, exec, rofi -show drun                # лаунчер
bind = SUPER, B, exec, firefox                        # браузер
bind = SUPER, M, exec, thunar                         # файловый менеджер

# Управление окнами
bind = SUPER, Q, killactive                            # закрыть активное окно
bind = SUPER, F, togglefullscreen                     # полноэкранный режим
bind = SUPER, T, togglefloating                       # переключить статус «плавающее»

# Перемещение/изменение размеров
bind = SUPER, H, movewindow, l                        # сдвинуть окно влево
bind = SUPER, L, movewindow, r                        # сдвинуть окно вправо
bind = SUPER, K, movewindow, u                        # сдвинуть окно вверх
bind = SUPER, J, movewindow, d                        # сдвинуть окно вниз
bind = SUPER+SHIFT, H, resizeactive, -20 0           # укоротить ширину
bind = SUPER+SHIFT, L, resizeactive, 20 0            # увеличить ширину
bind = SUPER+SHIFT, K, resizeactive, 0 -20           # укоротить высоту
bind = SUPER+SHIFT, J, resizeactive, 0 20            # увеличить высоту

# Переключение рабочих пространств
bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4
bind = SUPER, 5, workspace, 5

# Перемещение окна на другое рабочее пространство
bind = SUPER+SHIFT, 1, movetoworkspace, 1
bind = SUPER+SHIFT, 2, movetoworkspace, 2
bind = SUPER+SHIFT, 3, movetoworkspace, 3
bind = SUPER+SHIFT, 4, movetoworkspace, 4
bind = SUPER+SHIFT, 5, movetoworkspace, 5

# -------------------------------------------------
# 4. Тема и оформление
# -------------------------------------------------
# Цвета берутся из css‑подобного формата
# (можно использовать любой готовый набор, например из https://github.com/hyprwm/Hyprland/wiki/Config-Examples)
general {
    border_size = 2
    col.active_border = rgba(33,150,243,0.8)
    col.inactive_border = rgba(200,200,200,0.5)
    col.background = rgba(0,0,0,0.9)
}
